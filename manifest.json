{
  "manifest_version": 3,
  "name": "Расшифровка звонков Битрикс24",
  "version": "0.1.1",
  "description": "Скачивает записи разговоров из карточек CRM Битрикс24 и делает черновую расшифровку через Yandex SpeechKit.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "*://*/bitrix/tools/crm_show_file.php*",
    "https://stt.api.cloud.yandex.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/crm/*"],
      "all_frames": true,
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "action": {
    "default_title": "Расшифровка звонков Битрикс24",
    "default_popup": "src/popup.html"
  }
}
